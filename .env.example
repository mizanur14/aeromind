# AeroMind runtime configuration (copy to .env or export in your shell).
# No secrets are needed: the API and dashboard are unauthenticated local research tools.
# Do NOT expose the API publicly without adding authentication and TLS in front of it.

# Model registry (committed metadata; bundles it references live under artifacts/, not in Git)
AEROMIND_REGISTRY=reports/registry/model_registry.json
# Directory that registry bundle paths are relative to
AEROMIND_ROOT=.
# Local NASA C-MAPSS text files (never committed)
AEROMIND_DATA_DIR=data/raw/cmapss
# Result reports shown by the dashboard
AEROMIND_RESULTS_INDEX=configs/stage3/results_index.yaml
# Recommended for PyTorch on CPU
OMP_WAIT_POLICY=PASSIVE
